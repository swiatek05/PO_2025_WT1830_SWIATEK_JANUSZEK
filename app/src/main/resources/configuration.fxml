<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="presenter.ConfigurationPresenter">
    <VBox spacing="10">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <Label text="Konfiguracja Symulacji" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        <ComboBox fx:id="presetComboBox"/>

        <TitledPane text="Ustawienia Mapy" collapsible="false">
            <GridPane hgap="10" vgap="10">
                <Label text="Szerokość mapy:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Spinner fx:id="widthSpinner" initialValue="50" min="5" max="500" editable="true" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Wysokość mapy:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Spinner fx:id="heightSpinner" initialValue="50" min="5" max="500" editable="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Wariant mapy:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="variantComboBox" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>
        </TitledPane>

        <TitledPane text="Roślinność" collapsible="false">
            <GridPane hgap="10" vgap="10">
                <Label text="Startowa liczba roślin:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Spinner fx:id="startPlantsCountSpinner" initialValue="50" min="0" max="1000" editable="true" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Nowe rośliny co dzień:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Spinner fx:id="dailyGrowthSpinner" initialValue="5" min="0" max="100" editable="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Energia z rośliny:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Spinner fx:id="plantEnergySpinner" initialValue="10" min="1" max="100" editable="true" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label fx:id="plantPoisonDamageSpinnerLabel" text="Obrażenia trucizny:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Spinner fx:id="plantPoisonDamageSpinner" initialValue="5" min="0" max="100" editable="true" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label fx:id="plantPoisonChangeSpinnerLabel" text="Szansa na truciznę (0.0-1.0):" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <Spinner fx:id="plantPoisonChangeSpinner" initialValue="0.1" min="0.0" max="1.0" amountToStepBy="0.05" editable="true" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>
        </TitledPane>

        <TitledPane text="Statystyki Zwierząt" collapsible="false">
            <GridPane hgap="10" vgap="10">
                <Label text="Liczba zwierzaków:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Spinner fx:id="startAnimalsCountSpinner" initialValue="20" min="1" max="500" editable="true" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Startowa energia:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Spinner fx:id="startEnergySpinner" initialValue="20" min="1" max="200" editable="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Koszt dnia (metabolizm):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Spinner fx:id="dayEndEnergyLossSpinner" initialValue="1" min="1" max="50" editable="true" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Energia do rozmnażania:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Spinner fx:id="ableToMateEnergyNeededSpinner" initialValue="15" min="1" max="300" editable="true" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Koszt potomka:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <Spinner fx:id="energyUsedToMateSpinner" initialValue="10" min="1" max="300" editable="true" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>
        </TitledPane>

        <TitledPane text="Genetyka i Mutacje" collapsible="false">
            <GridPane hgap="10" vgap="10">
                <Label text="Min mutacji:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Spinner fx:id="minMutationsSpinner" initialValue="0" min="0" max="20" editable="true" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Max mutacji:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Spinner fx:id="maxMutationsSpinner" initialValue="2" min="0" max="20" editable="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Geny odporności (np. 1,2,5):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="genome" promptText="Wpisz liczby po przecinku" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>
        </TitledPane>

        <Button text="URUCHOM SYMULACJĘ" onAction="#onStartSimulation"
                maxWidth="Infinity" minHeight="50"
                style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>
    </VBox>
</ScrollPane>