<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<?import javafx.scene.control.ScrollPane?>
<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="simulation.SimulationPresenter">
    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background: #e0e0e0;">
            <StackPane>
                <GridPane fx:id="mapGrid" alignment="CENTER" gridLinesVisible="false" style="-fx-background-color: #dcdcdc;">
                </GridPane>
            </StackPane>
        </ScrollPane>
    </center>

<right>
<VBox alignment="TOP_CENTER" prefWidth="280.0" spacing="10.0"
      style="-fx-background-color: #f4f4f4; -fx-border-color: #cccccc; -fx-border-width: 0 0 0 1;">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Statystyki Symulacji"/>

    <Separator prefWidth="200.0"/>

    <GridPane hgap="10.0" vgap="8.0">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0"/>
            <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="10.0"/>
        </columnConstraints>

        <Label text="Dzień:" GridPane.rowIndex="0"/>
        <Label fx:id="day" style="-fx-font-weight: bold;" text="0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Liczba zwierząt:" GridPane.rowIndex="1"/>
        <Label fx:id="numberOfAnimals" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Liczba roślin:" GridPane.rowIndex="2"/>
        <Label fx:id="numberOfPlants" text="0" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Wolne pola:" GridPane.rowIndex="3"/>
        <Label fx:id="freeFields" text="0" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Najpopularniejszy gen:" GridPane.rowIndex="4"/>
        <Label fx:id="mostPopularGenom" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <Label text="Śr. energia:" GridPane.rowIndex="5"/>
        <Label fx:id="averageEnergy" text="0.00" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

        <Label text="Śr. długość życia:" GridPane.rowIndex="6"/>
        <Label fx:id="averageAgeForDead" text="0.00" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

        <Label text="Śr. liczba dzieci:" GridPane.rowIndex="7"/>
        <Label fx:id="averageChildrenCount" text="0.00" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
    </GridPane>

    <Separator prefWidth="200.0"/>

    <Button fx:id="pauseButton" maxWidth="1.7976931348623157E308" onAction="#onPauseButton" prefHeight="40.0"
            style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
            text="PAUZA"/>

    <Separator prefWidth="200.0"/>

    <Label style="-fx-font-weight: bold;" text="Legenda:"/>

    <VBox spacing="5.0">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Circle fill="BLUE" radius="6.0"/>
            <Label text="Zwierzę (im jaśniejsze = mniej energii)" wrapText="true"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Circle fill="TRANSPARENT" radius="6.0" stroke="BLACK" strokeWidth="2"/>
            <Label text="Dominator (Energia > 3x startowa)" wrapText="true"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Rectangle arcHeight="5.0" arcWidth="5.0" fill="LIMEGREEN" height="12.0" width="12.0"/>
            <Label text="Roślina pożywna"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Rectangle arcHeight="5.0" arcWidth="5.0" fill="RED" height="12.0" width="12.0"/>
            <Label text="Roślina trująca (bardziej czerwona = bardziej trująca)" wrapText="True"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Rectangle arcHeight="5.0" arcWidth="5.0" fill="BEIGE" height="12.0" width="12.0"/>
            <Label text="Pusta ziemia"/>
        </HBox>
    </VBox>

</VBox>
</right>
        </BorderPane>